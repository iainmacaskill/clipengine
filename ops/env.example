# Operator environment for clipengine cron jobs - copy to ~/.clipengine/env
# and chmod 600 it. Sourced by ops/clipengine-cron.sh; secrets live here,
# never in the crontab and never in the repo.

# Whop API key (read-only campaign discovery + reconciliation)
CLIPENGINE_WHOP_API_KEY=

# Discord-compatible webhook for campaign launch alerts
CLIPENGINE_ALERT_WEBHOOK=

# Config TOML for all jobs (DB paths, familiarity keywords, alert threshold)
CLIPENGINE_CONFIG=$HOME/.clipengine/config.toml

# Publishing credentials - only needed once queue run / stats sync are cronned
#CLIPENGINE_YT_CLIENT_ID=
#CLIPENGINE_YT_CLIENT_SECRET=
#CLIPENGINE_TT_CLIENT_KEY=
#CLIPENGINE_TT_CLIENT_SECRET=
